# Copy this file to the environment-specific file or dashboard:
# - Local: .env.local
# - Preview: hosting provider preview environment variables
# - Production: hosting provider production environment variables
#
# Do not commit real secrets or live credentials.

# Public client variables
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only application URL
APP_URL=

# Server-only Supabase variables
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Stripe variables
STRIPE_SECRET_KEY=
# Stripe Price ID for the current test/preview/production environment.
STRIPE_MENTORSHIP_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Server-only transactional email variables
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_WELCOME_ENABLED=
RESEND_API_KEY=
# Private operator destination; never use NEXT_PUBLIC_ for this value.
LIVE_ROOM_ALERT_EMAIL=
# Optional mentorship destination. Falls back to LIVE_ROOM_ALERT_EMAIL when empty.
MENTORSHIP_ALERT_EMAIL=
